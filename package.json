{
  "name": "riscsim",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir",
    "start": "npm run build:electron && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "screenshots": "node scripts/screenshot.mjs shots"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.28.0",
    "@lezer/highlight": "^1.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.10.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "description": "Visual RISC-V assembly editor and processor simulator for teaching computer architecture",
  "author": "RiscSim contributors",
  "license": "MIT",
  "main": "dist-electron/main.mjs",
  "homepage": "./",
  "build": {
    "appId": "dev.riscsim.app",
    "productName": "RiscSim",
    "copyright": "Copyright © 2026 RiscSim contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "maintainer": "RiscSim contributors"
    },
    "fileAssociations": [
      {
        "ext": "s",
        "name": "RISC-V assembly",
        "role": "Editor"
      },
      {
        "ext": "asm",
        "name": "RISC-V assembly",
        "role": "Editor"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joshwiersema/RiscVSim-Editor.git"
  },
  "bugs": {
    "url": "https://github.com/joshwiersema/RiscVSim-Editor/issues"
  }
}
